#!/bin/sh
# Собран Ansible — правки здесь затрутся при следующем деплое.
#
# Заметки лежат на каждой машине целиком, поэтому сервер — не единственная
# их копия. А вот история версий существует только здесь, и бэкап нужен
# ради неё.
set -eu

DATA={{ svod_data_dir }}
DEST={{ svod_backup_dir }}
STAMP=$(date +%F)

mkdir -p "$DEST/blobs"

# Копировать файл базы под нагрузкой нельзя — получится рваный снимок.
sqlite3 "$DATA/meta.db" ".backup '$DEST/meta-$STAMP.db'"

# Блобы неизменяемы и никогда не удаляются, поэтому докидываем
# только новые: полная копия каждый раз была бы расточительством.
rsync -a "$DATA/blobs/" "$DEST/blobs/"

find "$DEST" -maxdepth 1 -name 'meta-*.db' -mtime +{{ svod_backup_keep_days }} -delete

echo "бэкап готов: $DEST (снимок базы meta-$STAMP.db)"
